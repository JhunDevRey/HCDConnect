# Editor settings shared by everyone working on HCDConnect.
# Android Studio and most other editors pick this file up automatically.
# See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

# Windows batch files need Windows line endings.
[*.{bat,cmd}]
end_of_line = crlf
